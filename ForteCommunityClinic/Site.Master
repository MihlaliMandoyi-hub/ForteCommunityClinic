<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="ForteCommunityClinic.SiteMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>PrecisionCare Health Clinic</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="form1" runat="server">

        <nav class="top-navbar d-flex justify-content-between align-items-center px-3">
            <span class="clinic-brand"><i class="bi bi-hospital"></i>PrecisionCare Health Clinic</span>

            <asp:PlaceHolder ID="phUserBar" runat="server">
                <div class="d-flex align-items-center text-white">
                    <a href="~/Notifications/NotificationList.aspx" runat="server" class="text-white text-decoration-none me-3">
                        <i class="bi bi-bell"></i>
                        <asp:Label ID="lblUnreadCount" runat="server" CssClass="badge badge-count" />
                    </a>
                    <asp:Label ID="lblUserInfo" runat="server" CssClass="me-3" />
                    <asp:LinkButton ID="btnLogout" runat="server" CssClass="btn btn-sm btn-outline-light" OnClick="btnLogout_Click"><i class="bi bi-box-arrow-right"></i> Logout</asp:LinkButton>
                </div>
            </asp:PlaceHolder>
        </nav>

        <div class="clinic-layout">

            <asp:PlaceHolder ID="phSidebar" runat="server">
                <aside class="clinic-sidebar" id="clinicSidebar">
                    <ul class="nav flex-column">
                        <li class="nav-item"><a class="nav-link" href="~/Dashboard.aspx" runat="server"><i class="bi bi-speedometer2"></i>Dashboard</a></li>

                        <asp:PlaceHolder ID="phMyProfileNav" runat="server" Visible="false">
                            <li class="nav-item"><a class="nav-link" href="~/Account/MyProfile.aspx" runat="server"><i class="bi bi-person"></i>My Profile</a></li>
                        </asp:PlaceHolder>

                        <asp:PlaceHolder ID="phPatientsNav" runat="server" Visible="false">
                            <li class="nav-item"><a class="nav-link" href="~/Patients/PatientList.aspx" runat="server"><i class="bi bi-people"></i>Patients</a></li>
                        </asp:PlaceHolder>

                        <asp:PlaceHolder ID="phAppointmentsNav" runat="server" Visible="false">
                            <li class="nav-item"><a class="nav-link" id="lnkAppointments" href="~/Appointments/AppointmentList.aspx" runat="server"><i class="bi bi-calendar-check"></i>Appointments</a></li>
                        </asp:PlaceHolder>

                        <asp:PlaceHolder ID="phTodaysPatientsNav" runat="server" Visible="false">
                            <li class="nav-item"><a class="nav-link" href="~/Nursing/TodaysPatients.aspx" runat="server"><i class="bi bi-clipboard2-pulse"></i>Today's Patients</a></li>
                        </asp:PlaceHolder>

                        <asp:PlaceHolder ID="phPharmacyNav" runat="server" Visible="false">
                            <li class="nav-item"><a class="nav-link" href="~/Pharmacy/MedicationList.aspx" runat="server"><i class="bi bi-capsule"></i>Pharmacy</a></li>
                        </asp:PlaceHolder>

                        <asp:PlaceHolder ID="phBillingNav" runat="server" Visible="false">
                            <li class="nav-item"><a class="nav-link" id="lnkBilling" href="~/Billing/BillCreate.aspx" runat="server"><i class="bi bi-credit-card"></i>Billing</a></li>
                        </asp:PlaceHolder>

                        <asp:PlaceHolder ID="phClaimsNav" runat="server" Visible="false">
                            <li class="nav-item"><a class="nav-link" href="~/Claims/ClaimList.aspx" runat="server"><i class="bi bi-file-earmark-text"></i>Claims</a></li>
                        </asp:PlaceHolder>

                        <asp:PlaceHolder ID="phReportsNav" runat="server" Visible="false">
                            <li class="nav-item"><a class="nav-link" href="~/Reports/RevenueReport.aspx" runat="server"><i class="bi bi-bar-chart"></i>Reports</a></li>
                        </asp:PlaceHolder>

                        <asp:PlaceHolder ID="phAdminNav" runat="server" Visible="false">
                            <li class="nav-item"><a class="nav-link" href="~/Admin/AuditLogs.aspx" runat="server"><i class="bi bi-journal-text"></i>Audit Logs</a></li>
                        </asp:PlaceHolder>
                    </ul>
                </aside>
            </asp:PlaceHolder>

            <main class="clinic-main">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </main>
        </div>

        <footer class="clinic-footer text-center">
            &copy; <%: DateTime.Now.Year %> PrecisionCare Health Clinic System
        </footer>

    </form>
</body>
</html>